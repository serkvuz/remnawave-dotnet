root = true

[*]
indent_style = space
insert_final_newline = true
charset = utf-8

[*.cs]
indent_size = 4

[*.{json,xml,csproj,props,targets,yml,yaml}]
indent_size = 2

# Kiota output: never analyse or reformat.
[src/Remnawave.Client/Generated/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
